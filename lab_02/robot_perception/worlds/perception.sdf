<?xml version="1.0"?>
<!--
  Walled room with Gazebo Fuel models of COCO classes. The robot starts at the origin facing +x;
  the person is on its path (y = 0), the hydrant, suitcase and stop sign just beside it.
-->
<sdf version="1.9">
  <world name="perception">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <!-- Renders the lidar and camera of every robot in the world -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Room walls: inside, x from -1.5 to 8.5 and y from -3 to 3 -->
    <model name="wall_east">
      <static>true</static>
      <pose>8.55 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 1</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-1.55 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 6.2 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.2 1</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>3.5 3.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 1</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>3.5 -3.05 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 1</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- In the robot's path -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>person</name>
      <pose>7.0 0 0 0 0 -1.5708</pose>
      <static>true</static>
    </include>

    <!-- Just beside the path -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire hydrant</uri>
      <name>fire_hydrant</name>
      <pose>2.5 0.6 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Suitcase1</uri>
      <name>suitcase</name>
      <pose>4.0 -0.6 0 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Texture set as PBR: Gazebo Harmonic ignores the model's material script -->
    <model name="stop_sign">
      <static>true</static>
      <pose>5.5 0.7 0 0 0 -1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh><uri>https://fuel.gazebosim.org/1.0/chapulina/models/stop sign with spaces/2/files/meshes/stop sign.dae</uri></mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh><uri>https://fuel.gazebosim.org/1.0/chapulina/models/stop sign with spaces/2/files/meshes/stop sign.dae</uri></mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>https://fuel.gazebosim.org/1.0/chapulina/models/stop sign with spaces/2/files/materials/textures/StopSign Diffuse.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Near the walls -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>chair</name>
      <pose>2.0 -2.3 0 0 0 1.5708</pose>
      <static>true</static>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FoodCourtBenchShort</uri>
      <name>bench</name>
      <pose>5.0 2.4 0 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <name>walking_person</name>
      <pose>0.5 2.3 0 0 0 -1.5708</pose>
      <static>true</static>
    </include>

  </world>
</sdf>
